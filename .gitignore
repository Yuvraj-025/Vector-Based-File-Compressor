# =========================================================================
# YVCompressor Git Ignore Configuration
# =========================================================================

# --- Build and Output Directories ---
# Ignore CMake build outputs and fetched dependencies
/build/
/[Bb]uild/
/out/
/[Oo]ut/
/bin/
/x64/
/x86/

# --- Cache and Tool Directories ---
.cache/
.clangd/
.vs/
.vscode/
.idea/

# --- Dependency Managers ---
# FetchContent downloads/builds (usually under build/_deps)
_deps/

# --- C++ / Compiler Artifacts ---
# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic Libraries
*.so
*.dylib
*.dll

# Compiled Static Libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Debug symbols and linker files
*.pdb
*.ilk
*.idb
*.exp
*.map

# --- CMake Generated Files (In-source build prevention) ---
CMakeCache.txt
CMakeFiles/
CMakeSettings.json
CMakeUserPresets.json
cmake_install.cmake
Makefile
compile_commands.json

# --- OS Specific Files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Project Specific Artifacts ---
# Ignore generated vector compressed files
*.yvc

*.md
!README.md